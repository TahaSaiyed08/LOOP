# LLM: Gemini via its OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash-lite
# lite (full council) or mini (fallback, fewer calls)
COUNCIL_MODE=mini
# model used once on a 404 / retired model (default gemini-3.1-flash-lite)
# FALLBACK_GEMINI_MODEL=gemini-3.1-flash-lite


# TigerData PostgreSQL
DATABASE_URL= 


# Alpaca paper trading (free, no card)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# optional overrides (tests/mocks)
# ALPACA_PAPER_URL=https://paper-api.alpaca.markets
# ALPACA_DATA_URL=https://data.alpaca.markets

# News (Finnhub free tier: 300 calls/day)
FINNHUB_KEY=

# Webhooks
INBOUND_WEBHOOK_SECRET=
N8N_NOTIFY_WEBHOOK_URL=
# n8n webhook that starts the daily workflow (POST /api/admin/run-pipeline forwards to it)
N8N_RUN_WEBHOOK_URL=

PORT=3000

# Demo scaffolding: on boot, if the paper ledger is empty and Alpaca keys exist, seed 4 backdated trades
DEMO_SEED=false

# Contract E recipient (Contract C has no email field) and link base for the email button
NOTIFY_TO_EMAIL=
PUBLIC_URL=
